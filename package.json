{
  "name": "mindwiki",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint src plugins --max-warnings 0",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.txt$": "<rootDir>/__mocks__/txtMock.js"
    },
    "forceExit": true,
    "transformIgnorePatterns": [
      "/node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|zustand|immer|@scure/.*|@noble/.*)",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/worktrees/",
      "fixtures/"
    ],
    "collectCoverage": false,
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 81,
        "statements": 79,
        "functions": 79,
        "branches": 69
      }
    }
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "~14.0.4",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@op-engineering/op-sqlite": "^18.0.0",
    "@react-native-community/netinfo": "11.4.1",
    "@scure/bip39": "^2.2.0",
    "expo": "~52.0.11",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.3",
    "expo-local-authentication": "~15.0.2",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.9",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "immer": "^11.1.16",
    "llama.rn": "^0.12.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-argon2": "^4.0.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.0",
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
