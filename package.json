{
  "name": "mindwiki",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|zustand|immer)",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^16.2.0",
    "expo": "~52.0.11",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.2",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "immer": "^11.1.8",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "prettier": "^3.3.3",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  }
}
