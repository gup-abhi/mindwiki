{
  "expo": {
    "name": "MindWiki",
    "slug": "mindwiki",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "mindwiki",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.mindwiki.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mindwiki.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F4739"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "MindWiki uses the camera only to scan a pairing QR code from another of your devices."
        }
      ],
      "expo-font",
      "./plugins/withPrivacyProtection",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F4739",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#121613",
            "image": "./assets/splash-icon.png",
            "imageWidth": 200
          }
        }
      ]
    ]
  }
}
