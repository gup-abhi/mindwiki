{
  "expo": {
    "name": "MindWiki",
    "slug": "mindwiki",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "mindwiki",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mindwiki.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mindwiki.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "MindWiki uses the camera only to scan a pairing QR code from another of your devices."
        }
      ]
    ]
  }
}
